@page
@model HotelBookingSystem.Pages.Bookings.SchedulerModel
@{
    ViewData["Title"] = "Booking Calendar";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h1 class="h3 mb-1">Booking Calendar</h1>
        <div class="text-muted">Each room uses a consistent color. Click a booking to open its invoice.</div>
    </div>
    <a asp-page="Create" class="btn btn-primary">+ New Booking</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div id="calendar"></div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.19/index.global.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.19/index.global.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const calendar = new FullCalendar.Calendar(document.getElementById("calendar"), {
                initialView: "timeGridWeek",
                height: 760,
                nowIndicator: true,
                allDaySlot: false,
                slotMinTime: "06:00:00",
                slotMaxTime: "24:00:00",
                headerToolbar: {
                    left: "prev,next today",
                    center: "title",
                    right: "dayGridMonth,timeGridWeek,timeGridDay"
                },
                eventTimeFormat: {
                    hour: "2-digit",
                    minute: "2-digit",
                    hour12: true
                },
                events: {
                    url: "/Bookings/Scheduler?handler=Events",
                    method: "GET",
                    failure: function () {
                        alert("Could not load booking calendar.");
                    }
                }
            });

            calendar.render();
        });
    </script>
}
