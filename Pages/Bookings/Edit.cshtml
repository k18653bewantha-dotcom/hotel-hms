@page "{id:int}"
@model HotelBookingSystem.Pages.Bookings.EditModel
@{
    ViewData["Title"] = "Edit Booking";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h1 class="h3 mb-1">Edit @Model.BookingNo</h1>
        <div class="text-muted">Admin-only editing before checkout. Restaurant charges remain controlled by Restaurant POS.</div>
    </div>
    <a asp-page="Index" class="btn btn-outline-secondary">Back to Bookings</a>
</div>

<div class="alert alert-warning">
    <strong>Admin control:</strong> Changes here update the booking and invoice totals. Checked-out and cancelled bookings cannot be edited.
</div>

<form method="post" id="editBookingForm">
    <input asp-for="Input.Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-dark text-white"><h2 class="h5 mb-0">Guest & Stay Details</h2></div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-lg-4">
                    <label asp-for="Input.CustomerId" class="form-label">Customer</label>
                    <select asp-for="Input.CustomerId" asp-items="Model.Customers" class="form-select">
                        <option value="">-- Select Customer --</option>
                    </select>
                    <span asp-validation-for="Input.CustomerId" class="text-danger"></span>
                </div>

                <div class="col-lg-4">
                    <label asp-for="Input.CheckIn" class="form-label">Check In</label>
                    <input asp-for="Input.CheckIn" type="datetime-local" class="form-control" id="checkIn" />
                </div>

                <div class="col-lg-4">
                    <label asp-for="Input.CheckOut" class="form-label">Check Out</label>
                    <input asp-for="Input.CheckOut" type="datetime-local" class="form-control" id="checkOut" />
                </div>

                <div class="col-md-4">
                    <label asp-for="Input.MealPlan" class="form-label">Meal Plan</label>
                    <select asp-for="Input.MealPlan" class="form-select">
                        <option value="@MealPlans.RO">RO - Room Only</option>
                        <option value="@MealPlans.BB">BB - Bed & Breakfast</option>
                        <option value="@MealPlans.HB">HB - Half Board</option>
                        <option value="@MealPlans.FB">FB - Full Board</option>
                    </select>
                    <span asp-validation-for="Input.MealPlan" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Input.Adults" class="form-label">Adults</label>
                    <input asp-for="Input.Adults" type="number" min="1" class="form-control" />
                    <span asp-validation-for="Input.Adults" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Input.Children" class="form-label">Children</label>
                    <input asp-for="Input.Children" type="number" min="0" class="form-control" />
                    <span asp-validation-for="Input.Children" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h2 class="h5 mb-0">Rooms</h2>
                <small class="text-muted">Only rooms available for the edited dates are shown.</small>
            </div>
            <button type="button" class="btn btn-outline-success btn-sm" id="refreshRooms">Refresh Availability</button>
        </div>
        <div class="card-body">
            <div id="roomLoading" class="text-center py-4 d-none">
                <div class="spinner-border text-success" role="status"></div>
                <div class="mt-2 text-muted">Checking room availability...</div>
            </div>

            <div id="availableRooms" class="row g-3">
                @foreach (var room in Model.AvailableRooms)
                {
                    <div class="col-sm-6 col-md-4 col-xl-3">
                        <label class="room-select-card">
                            <div class="d-flex justify-content-between align-items-start">
                                <input type="checkbox"
                                       name="SelectedRoomIds"
                                       value="@room.Id"
                                       class="form-check-input"
                                       checked="@Model.SelectedRoomIds.Contains(room.Id)" />
                                <span class="badge bg-success">Available</span>
                            </div>
                            <div class="h4 mb-1 mt-3">Room @room.RoomNumber</div>
                            <div class="text-muted">@room.RoomType</div>
                            <div class="small mt-2">Capacity: @room.Capacity guest(s)</div>
                        </label>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-dark text-white"><h2 class="h5 mb-0">Invoice / Billing Details</h2></div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Input.RoomCharge" class="form-label">Total Room Charge</label>
                    <div class="input-group"><span class="input-group-text">Rs.</span><input asp-for="Input.RoomCharge" class="form-control" min="0" step="0.01" /></div>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.SeasonalChargePercent" class="form-label">Seasonal Charge %</label>
                    <input asp-for="Input.SeasonalChargePercent" class="form-control" min="0" step="0.01" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.Discount" class="form-label">Discount</label>
                    <div class="input-group"><span class="input-group-text">Rs.</span><input asp-for="Input.Discount" class="form-control" min="0" step="0.01" /></div>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.AdvancePayment" class="form-label">Advance Payment / Deposit</label>
                    <div class="input-group"><span class="input-group-text">Rs.</span><input asp-for="Input.AdvancePayment" class="form-control" min="0" step="0.01" /></div>
                    <span asp-validation-for="Input.AdvancePayment" class="text-danger"></span>
                    <div class="form-text">Amount already received from the guest.</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Restaurant Bill</label>
                    <input class="form-control" value="@(Model.RestaurantBill.ToString("N2"))" readonly />
                    <div class="form-text">Auto-calculated from served room-charge orders.</div>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.BarBill" class="form-label">Bar Bill</label>
                    <input asp-for="Input.BarBill" class="form-control" min="0" step="0.01" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.LaundryBill" class="form-label">Laundry Bill</label>
                    <input asp-for="Input.LaundryBill" class="form-control" min="0" step="0.01" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.PaymentStatus" class="form-label">Payment Status</label>
                    <select asp-for="Input.PaymentStatus" class="form-select">
                        <option value="@PaymentStatuses.Pending">Pending</option>
                        <option value="@PaymentStatuses.PartPaid">Part Paid</option>
                        <option value="@PaymentStatuses.Paid">Paid</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.PaymentMethod" class="form-label">Payment Method</label>
                    <select asp-for="Input.PaymentMethod" class="form-select">
                        <option>Cash</option>
                        <option>Credit Card</option>
                        <option>Bank Transfer</option>
                        <option>Online Payment</option>
                    </select>
                </div>
                <div class="col-md-12">
                    <label asp-for="Input.Remarks" class="form-label">Remarks</label>
                    <textarea asp-for="Input.Remarks" class="form-control" rows="3"></textarea>
                </div>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary btn-lg">Save Admin Changes</button>
    <a asp-page="Index" class="btn btn-secondary btn-lg">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const bookingId = @Model.Input.Id;
        const checkIn = document.getElementById("checkIn");
        const checkOut = document.getElementById("checkOut");
        const container = document.getElementById("availableRooms");
        const loading = document.getElementById("roomLoading");
        const refreshButton = document.getElementById("refreshRooms");

        function escapeHtml(value) {
            const div = document.createElement("div");
            div.textContent = value ?? "";
            return div.innerHTML;
        }

        function selectedIds() {
            return new Set(Array.from(document.querySelectorAll('input[name="SelectedRoomIds"]:checked'))
                .map(x => Number(x.value)));
        }

        async function loadAvailableRooms() {
            const keepSelected = selectedIds();

            if (!checkIn.value || !checkOut.value || new Date(checkOut.value) <= new Date(checkIn.value)) {
                container.innerHTML = '<div class="col-12"><div class="alert alert-danger mb-0">Select valid check-in and check-out dates.</div></div>';
                return;
            }

            loading.classList.remove("d-none");
            container.classList.add("d-none");

            try {
                const url = `?handler=AvailableRooms&id=${bookingId}&checkIn=${encodeURIComponent(checkIn.value)}&checkOut=${encodeURIComponent(checkOut.value)}`;
                const response = await fetch(url);
                if (!response.ok) throw new Error("Unable to load rooms.");
                const rooms = await response.json();

                container.innerHTML = rooms.length === 0
                    ? '<div class="col-12"><div class="alert alert-warning mb-0">No rooms available for these dates.</div></div>'
                    : rooms.map(room => `
                        <div class="col-sm-6 col-md-4 col-xl-3">
                            <label class="room-select-card">
                                <div class="d-flex justify-content-between align-items-start">
                                    <input type="checkbox" name="SelectedRoomIds" value="${room.id}" class="form-check-input" ${keepSelected.has(room.id) ? 'checked' : ''} />
                                    <span class="badge bg-success">Available</span>
                                </div>
                                <div class="h4 mb-1 mt-3">Room ${escapeHtml(room.roomNumber)}</div>
                                <div class="text-muted">${escapeHtml(room.roomType)}</div>
                                <div class="small mt-2">Capacity: ${room.capacity} guest(s)</div>
                            </label>
                        </div>`).join("");
            } catch (error) {
                container.innerHTML = `<div class="col-12"><div class="alert alert-danger mb-0">${escapeHtml(error.message)}</div></div>`;
            } finally {
                loading.classList.add("d-none");
                container.classList.remove("d-none");
            }
        }

        checkIn.addEventListener("change", loadAvailableRooms);
        checkOut.addEventListener("change", loadAvailableRooms);
        refreshButton.addEventListener("click", loadAvailableRooms);
    </script>
}
