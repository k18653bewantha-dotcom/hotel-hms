@page
@using HotelBookingSystem.Models
@model HotelBookingSystem.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
    var homePage = User.IsInRole(UserRoles.Restaurant)
        ? "/Restaurant/POS"
        : User.IsInRole(UserRoles.Housekeeping)
            ? "/Housekeeping/Index"
            : "/Index";
}

<div class="text-center py-5">
    <div class="display-1">⛔</div>
    <h1 class="h2">Access Denied</h1>
    <p class="text-muted">Your account does not have permission to open this section.</p>
    <a asp-page="@homePage" class="btn btn-primary">Return to My Dashboard</a>
</div>
