@page
@model HotelBookingSystem.Pages.Account.SetupModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>First Setup - Kingswood Hotel PMS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { min-height: 100vh; display: grid; place-items: center; background: #eef2ef; padding: 20px; }
        .setup-card { width: 100%; max-width: 580px; border: 0; border-radius: 20px; }
    </style>
</head>
<body>
<div class="card setup-card shadow-lg">
    <div class="card-body p-4 p-md-5">
        <div class="text-center mb-4">
            <div class="display-4">🔐</div>
            <h1 class="h3">First-Time Security Setup</h1>
            <p class="text-muted mb-0">Create the first administrator account. No default password is stored in the system.</p>
        </div>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Input.DisplayName" class="form-label"></label>
                <input asp-for="Input.DisplayName" class="form-control" autofocus />
                <span asp-validation-for="Input.DisplayName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Username" class="form-label"></label>
                <input asp-for="Input.Username" class="form-control" autocomplete="username" />
                <span asp-validation-for="Input.Username" class="text-danger"></span>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.Password" class="form-label"></label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
            </div>

            <div class="form-text mt-2">At least 8 characters, including a letter and a number.</div>
            <button class="btn btn-success btn-lg w-100 mt-4">Create Administrator</button>
        </form>
    </div>
</div>
<partial name="_ValidationScriptsPartial" />
</body>
</html>
