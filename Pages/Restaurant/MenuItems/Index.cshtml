@page
@model HotelBookingSystem.Pages.Restaurant.MenuItems.IndexModel
@{
    ViewData["Title"] = "Menu Items";
}

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="card shadow-sm mb-4">
    <div class="card-header bg-dark text-white"><h1 class="h5 mb-0">Add Menu Item</h1></div>
    <div class="card-body">
        <form method="post" asp-page-handler="Create" class="row g-3">
            <div class="col-md-4">
                <label asp-for="NewItem.Name" class="form-label"></label>
                <input asp-for="NewItem.Name" class="form-control" />
                <span asp-validation-for="NewItem.Name" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="NewItem.MenuCategoryId" class="form-label">Category</label>
                <select asp-for="NewItem.MenuCategoryId" asp-items="Model.Categories" class="form-select"></select>
            </div>
            <div class="col-md-3">
                <label asp-for="NewItem.Price" class="form-label"></label>
                <input asp-for="NewItem.Price" class="form-control" min="0" step="0.01" />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button class="btn btn-primary w-100">Add Item</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white"><h2 class="h5 mb-0">Menu Items</h2></div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr><th>Name</th><th>Category</th><th>Price</th><th>Status</th><th style="min-width:420px">Actions</th></tr>
                </thead>
                <tbody>
                @foreach (var item in Model.MenuItems)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.MenuCategory?.Name</td>
                        <td>Rs. @item.Price.ToString("N2")</td>
                        <td>
                            <span class="badge @(item.IsAvailable ? "bg-success" : "bg-secondary")">
                                @(item.IsAvailable ? "Available" : "Disabled")
                            </span>
                        </td>
                        <td>
                            <form method="post" asp-page-handler="Edit" class="row g-1 align-items-center">
                                <input type="hidden" name="id" value="@item.Id" />
                                <div class="col"><input name="name" value="@item.Name" class="form-control form-control-sm" required /></div>
                                <div class="col">
                                    <select name="menuCategoryId" class="form-select form-select-sm">
                                        @foreach (var option in Model.Categories)
                                        {
                                            if (option.Value == item.MenuCategoryId.ToString())
                                            {
                                                <option value="@option.Value" selected>@option.Text</option>
                                            }
                                            else
                                            {
                                                <option value="@option.Value">@option.Text</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col"><input name="price" value="@item.Price" type="number" min="0" step="0.01" class="form-control form-control-sm" /></div>
                                <div class="col-auto"><button class="btn btn-sm btn-outline-primary">Save</button></div>
                            </form>

                            <form method="post" asp-page-handler="Toggle" class="d-inline">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button class="btn btn-sm btn-outline-secondary mt-1">Toggle</button>
                            </form>
                            <form method="post" asp-page-handler="Delete" class="d-inline">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button class="btn btn-sm btn-outline-danger mt-1" data-confirm="Delete this menu item?">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
