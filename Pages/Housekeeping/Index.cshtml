@page
@model HotelBookingSystem.Pages.Housekeeping.IndexModel
@{
    ViewData["Title"] = "Housekeeping";
}

<div class="mb-4">
    <h1 class="h3 mb-1">Housekeeping</h1>
    <div class="text-muted">Update room cleaning and maintenance status.</div>
</div>

<div class="row g-3">
@foreach (var room in Model.Rooms)
{
    var cardClass = room.Status switch
    {
        RoomStatuses.Ready => "border-success",
        RoomStatuses.Occupied => "border-danger",
        RoomStatuses.Reserved => "border-warning",
        RoomStatuses.Cleaning => "border-info",
        RoomStatuses.Dirty => "border-secondary",
        RoomStatuses.Maintenance => "border-dark",
        _ => "border-secondary"
    };

    var badgeClass = room.Status switch
    {
        RoomStatuses.Ready => "bg-success",
        RoomStatuses.Occupied => "bg-danger",
        RoomStatuses.Reserved => "bg-warning text-dark",
        RoomStatuses.Cleaning => "bg-info text-dark",
        RoomStatuses.Dirty => "bg-secondary",
        RoomStatuses.Maintenance => "bg-dark",
        _ => "bg-secondary"
    };

    <div class="col-sm-6 col-lg-4 col-xl-3">
        <div class="card shadow-sm h-100 border-2 @cardClass">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="h3 mb-0">Room @room.RoomNumber</div>
                        <div class="text-muted">@room.RoomType</div>
                    </div>
                    <span class="badge @badgeClass">@room.Status</span>
                </div>

                <hr />

                <div class="d-grid gap-2">
                    <form method="post" asp-page-handler="SetStatus">
                        <input type="hidden" name="id" value="@room.Id" />
                        <input type="hidden" name="status" value="@RoomStatuses.Cleaning" />
                        <button class="btn btn-outline-info w-100">Start Cleaning</button>
                    </form>

                    <form method="post" asp-page-handler="SetStatus">
                        <input type="hidden" name="id" value="@room.Id" />
                        <input type="hidden" name="status" value="@RoomStatuses.Ready" />
                        <button class="btn btn-success w-100">Mark Ready</button>
                    </form>

                    <form method="post" asp-page-handler="SetStatus">
                        <input type="hidden" name="id" value="@room.Id" />
                        <input type="hidden" name="status" value="@RoomStatuses.Maintenance" />
                        <button class="btn btn-outline-dark w-100">Maintenance</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
</div>
