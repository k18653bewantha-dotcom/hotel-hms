@page
@model HotelBookingSystem.Pages.Reports.IndexModel
@{
    ViewData["Title"] = "Reports";
}

<div class="mb-3">
    <h1 class="h3 mb-1">Revenue & Operations Report</h1>
    <div class="text-muted">Hotel and restaurant summary for a selected date range.</div>
</div>

<div class="card shadow-sm mb-4 no-print">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label asp-for="From" class="form-label">From</label>
                <input asp-for="From" type="date" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="To" class="form-label">To</label>
                <input asp-for="To" type="date" class="form-control" />
            </div>
            <div class="col-md-4 d-grid">
                <button class="btn btn-primary">Run Report</button>
            </div>
        </form>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="fw-semibold">@Model.From.ToString("dd MMM yyyy") – @Model.To.ToString("dd MMM yyyy")</div>
    <button onclick="window.print()" class="btn btn-outline-dark no-print">Print Report</button>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted">Hotel Revenue</div>
                <div class="h3">Rs. @Model.HotelRevenue.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted">Room Revenue</div>
                <div class="h3">Rs. @Model.RoomRevenue.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted">Service Revenue</div>
                <div class="h3">Rs. @Model.ServiceRevenue.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted">Restaurant Orders</div>
                <div class="h3">Rs. @Model.RestaurantSales.ToString("N2")</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="alert alert-success mb-0"><strong>@Model.CheckedOutBookings</strong> completed bookings</div>
    </div>
    <div class="col-md-4">
        <div class="alert alert-info mb-0"><strong>@Model.TotalRoomNights</strong> room nights</div>
    </div>
    <div class="col-md-4">
        <div class="alert alert-secondary mb-0"><strong>@Model.CancelledBookings</strong> cancelled bookings</div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-dark text-white"><h2 class="h5 mb-0">Booking Revenue</h2></div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Booking</th>
                        <th>Guest</th>
                        <th>Rooms</th>
                        <th>Checkout</th>
                        <th>Status</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Bookings.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No bookings in this period.</td></tr>
                }
                else
                {
                    @foreach (var booking in Model.Bookings)
                    {
                        <tr>
                            <td>@booking.BookingNo</td>
                            <td>@booking.Customer?.FullName</td>
                            <td>@booking.RoomsDisplay</td>
                            <td>@booking.CheckOut.ToString("dd MMM yyyy")</td>
                            <td>@booking.Status</td>
                            <td class="text-end">Rs. @booking.GrandTotal.ToString("N2")</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-dark text-white"><h2 class="h5 mb-0">Restaurant Orders</h2></div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Order</th>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Table / Booking</th>
                        <th>Status</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Orders.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No restaurant orders in this period.</td></tr>
                }
                else
                {
                    @foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td>@order.OrderNumber</td>
                            <td>@order.OrderTime.ToString("dd MMM yyyy HH:mm")</td>
                            <td>@order.OrderType</td>
                            <td>@(order.OrderType == OrderTypes.RoomCharge ? order.Booking?.BookingNo : order.RestaurantTable?.TableNumber)</td>
                            <td>@order.Status</td>
                            <td class="text-end">Rs. @order.TotalAmount.ToString("N2")</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
